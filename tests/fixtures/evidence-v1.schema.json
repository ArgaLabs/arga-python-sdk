      "type": "array"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "arga.evidence.v1",
      "default": "arga.evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Source",
      "type": "string"
    }
