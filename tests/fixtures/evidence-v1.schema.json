{
  "$defs": {
    "Error": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "provider",
            "permission",
            "rate_limit",
            "network",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "rate_limit",
                "resource_missing",
                "permission_denied",
                "invalid_request",
                "insufficient_funds",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        }
      },
      "required": [
        "category"
      ],
      "title": "Error",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complete"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
