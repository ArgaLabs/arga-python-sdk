  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Episode Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "maxItems": 100,
      "title": "Events",
      "type": "array"
    },
    "goal": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "issues": {
      "items": {
        "enum": [
          "unsupported_operation",
          "projection_failed",
          "record_limit",
          "event_limit",
          "payload_limit",
          "source_incomplete",
          "text_dropped",
          "agent_error"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "title": "Issues",
      "type": "array"
    },
